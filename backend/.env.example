# --- AI (multimodal agent) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Voice / SMS (Twilio). Leave blank to run in MOCK mode (calls are only logged) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# voice = text-to-speech call, missed = ring and hang up
CALL_MODE=voice
PUBLIC_BASE_URL=http://localhost:8000

# --- App ---
DB_PATH=medlens.db
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
